lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ---- 虚拟环境 ----
.venv/
venv/
env/
ENV/
.python-version

# ---- PyInstaller ----
*.spec
# 强制包含我们自定义的打包配置文件
!main.spec

# ---- 运行生成的文件 ----
# 用户上传的自定义图片/GIF 文件夹
custom_assets/
# 配置文件包含用户的本地路径，不建议提交（程序首次运行会自动生成）
config.json
# 运行日志
*.log

# ---- 语音模型 (体积过大，请自行下载) ----
model/
model/*

# ---- 插件本地私有库 ----
# 如果你想把自己写的插件提交到仓库，请删除下面这行
# 如果你只想保留示例插件，请保留这行
plugins/*
!plugins/demo_chat.py
!plugins/__init__.py

# ---- 缓存 / 测试 ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

